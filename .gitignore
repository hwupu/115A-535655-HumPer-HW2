# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta
# Autogenerated Unity/IDE project files
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
sysinfo.txt
# Build outputs
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
# Gradle / Android build temp
*.keystore
*.jks
/[Aa]ssets/Plugins/Android/*.androidlib/build/
.gradle/
local.properties
# Burst / shader / cache temp
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
# IDE
.vs/
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
.utmp/
.claude/settings.local.json
# OS-specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# Participant data pulled from headset (keep out of repo)
/ParticipantData/
